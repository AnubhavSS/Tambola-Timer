{
  "expo": {
    "name": "tambola-timer",
    "slug": "tambola-timer",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/images/logoo.png",
    "scheme": "tambolatimer",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anubhavss.tambolatimer",
      "googleMobileAdsAppId": "ca-app-pub-2097672905689831~6487545007",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },

    "android": {
      "googleMobileAdsAppId": "ca-app-pub-2097672905689831~6487545007",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/logoo.png",
        "backgroundImage": "./assets/images/logoo.png",
        "monochromeImage": "./assets/images/logoo.png"
      
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anubhavss.tambolatimer",
      "googleServicesFile": "./google-services.json"
    },

    "plugins": [
      "expo-router",
       "@react-native-firebase/app",
      "@react-native-firebase/crashlytics",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-2097672905689831~6487545007",
          "iosAppId": "ca-app-pub-2097672905689831~6487545007"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logoo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],

    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "db614e1a-7ed5-4979-b0a1-4ce0bf171a5a"
      }
    }
  }
}
