{
  "expo": {
    "name": "Tambola-Timer",
    "slug": "tambola-timer",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#140C08"
    },
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/images/icon.jpeg",
    "scheme": "tambolatimer",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anubhavss.tambolatimer",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.jpeg",
        "backgroundColor": "#E6F4FE"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anubhavss.tambolatimer",
      "googleServicesFile": "./google-services.json",
      
    },
    "plugins": [
      "expo-router",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-2097672905689831~6487545007",
          "iosAppId": "ca-app-pub-2097672905689831~6487545007"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#140C08",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#140C08"
          }
        }
      ],
      "expo-web-browser"
    ],
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "db614e1a-7ed5-4979-b0a1-4ce0bf171a5a"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/db614e1a-7ed5-4979-b0a1-4ce0bf171a5a"
    },
    
  }
}
