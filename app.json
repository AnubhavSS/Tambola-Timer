{
  "expo": {
    "name": "Tambola-Timer",
    "slug": "Tambola-Timer",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/images/icon.jpeg",
    "scheme": "tambolatimer",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anubhavss.tambolatimer",
      "googleMobileAdsAppId": "ca-app-pub-2097672905689831~6487545007",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "googleMobileAdsAppId": "ca-app-pub-2097672905689831~6487545007",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/icon.jpeg",
        "backgroundImage": "./assets/images/icon.jpeg",
        "monochromeImage": "./assets/images/icon.jpeg"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anubhavss.tambolatimer",
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-2097672905689831~6487545007",
          "iosAppId": "ca-app-pub-2097672905689831~6487545007"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.jpeg",
          "imageWidth": "100%",
          "resizeMode": "corver",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "pocketnest-apps"
        }
      ],
      "expo-web-browser"
    ],
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "db614e1a-7ed5-4979-b0a1-4ce0bf171a5a"
      }
    }
  }
}
